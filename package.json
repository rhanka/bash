{
  "name": "@sentropic/bash",
  "version": "0.0.0",
  "private": true,
  "description": "A zero-dependency, WASM-first, security- and performance-focused bash sandbox (clean-room reimplementation with functional parity to vercel-labs/just-bash).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./dist/js/browser.js"
    }
  },
  "files": [
    "dist/js/shared.js",
    "dist/js/index.js",
    "dist/js/browser.js",
    "dist/js/core/ext.js",
    "dist/js/node/adapters.js",
    "dist/js/node/load.js",
    "dist/js/kernel/kernel.core.wasm",
    "dist/kernel.component.wasm",
    "types/",
    "wit/",
    "DIVERGENCES.md"
  ],
  "dependencies": {},
  "devDependencies": {}
}

{
  "components": {
    "probe": {
      "crate": "sentropic-bash-probe",
      "witDir": "probe/wit",
      "world": "probe",
      "wasmOpt": false
    },
    "kernel": {
      "crate": "sentropic-bash-kernel",
      "witDir": "wit",
      "world": "kernel",
      "wasmOpt": false,
      "bindings": {
        "dir": "kernel/src/bindings",
        "witDir": "wit",
        "world": "kernel",
        "args": [
          "--std-feature",
          "--runtime-path",
          "crate::glue::rt",
          "--bitflags-path",
          "crate::glue::rt::bitflags",
          "--disable-custom-section-link-helpers"
        ]
      }
    },
    "kernel-test": {
      "crate": "sentropic-bash-kernel",
      "witDir": "wit",
      "world": "kernel",
      "wasmOpt": false,
      "features": [
        "test-commands"
      ],
      "test": true
    }
  }
}
